# ==============================================================================
# AL MUKAMMAL COMPUTER TRADING LLC — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file to .env.local for local development, or add these keys
# to your production hosting environment (e.g., Vercel, AWS ECS, Docker, PM2).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas or Self-Hosted)
# ------------------------------------------------------------------------------
# Production connection string with replica set and SSL enabled.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.almukammal.mongodb.net/almukammal_prod?retryWrites=true&w=majority&appName=AlMukammal"

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY (JWT & Session Signing)
# ------------------------------------------------------------------------------
# High-entropy random 256-bit string (generate via: openssl rand -base64 32)
# Required in production; application will fail startup if missing.
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here-for-production"

# Optional NextAuth Secret (defaults to JWT_SECRET if unset)
NEXTAUTH_SECRET="generate-another-secure-secret-here-for-nextauth"

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE ACCESS REGISTRATION
# ------------------------------------------------------------------------------
# Passcode required when provisioning new staff/admin accounts at /auth/admin/register
ADMIN_SECRET_KEY="almukammal-staff-provisioning-secret-2026"

# ------------------------------------------------------------------------------
# 4. BUSINESS & STORE LOCALIZATION (UAE Market)
# ------------------------------------------------------------------------------
# Official WhatsApp Order Consultation Hotline (format without spaces or symbols for wa.me)
NEXT_PUBLIC_WHATSAPP_NUMBER="971509550121"

# Production Canonical Application Origin
NEXT_PUBLIC_APP_URL="https://almukammal.ae"

# Currency Code (Default: AED)
NEXT_PUBLIC_CURRENCY="AED"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Hostname of the production SMTP mail provider (e.g., smtp.gmail.com, smtp.sendgrid.net, etc.)
SMTP_HOST="smtp.gmail.com"

# SMTP port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT="587"

# SMTP authentication username / account
SMTP_USER="your-smtp-email@example.com"

# SMTP authentication password or App Password
SMTP_PASSWORD="your-app-specific-password-or-api-key"

# Set to "true" if using port 465 or explicit TLS
SMTP_SECURE="false"

# Sender address shown in customer inboxes
SMTP_FROM="\"Al Mukammal Computer Trading\" <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 6. OTP & EMAIL VERIFICATION SECURITY
# ------------------------------------------------------------------------------
# Dedicated secret for HMAC-SHA256 OTP hashing (defaults to JWT_SECRET if unset)
OTP_SECRET="generate-a-secure-otp-secret-key-here-for-production"

# OTP lifetime in minutes (default: 5 minutes)
OTP_EXPIRY_MINUTES="5"

# Length of numeric OTP code (default: 6)
OTP_LENGTH="6"

# Maximum failed verification attempts before OTP is invalidated (default: 5)
OTP_MAX_ATTEMPTS="5"

# Cooldown time between OTP resends in seconds (default: 60 seconds)
OTP_RESEND_COOLDOWN_SECONDS="60"
